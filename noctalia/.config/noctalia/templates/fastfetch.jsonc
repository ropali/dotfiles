// Fastfetch theme generated by Noctalia.
// Edit these colors in noctalia/.config/noctalia/templates/fastfetch.jsonc,
// then run: noctalia msg templates-apply

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": {
            "top": 1,
            "right": 4
        },
        "color": {
            "1": "{{colors.outline.default.hex}}",
            "2": "{{colors.primary.default.hex}}",
            "3": "{{colors.on_surface.default.hex}}",
            "4": "{{colors.secondary.default.hex}}"
        }
    },
    "display": {
        "separator": "  ",
        "percent": {
            "type": 3,
            "color": {
                "green": "{{colors.tertiary.default.hex}}",
                "yellow": "{{colors.primary_fixed_dim.default.hex}}",
                "red": "{{colors.error.default.hex}}"
            }
        },
        "key": {
            "width": 12,
            "paddingLeft": 2
        },
        "constants": [
            "  ────────────────────────────────────────────────"
        ],
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": null,
            "color": {
                "elapsed": "auto",
                "total": "{{colors.outline_variant.default.hex}}"
            },
            "width": 9
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{#{{colors.primary.default.hex}}}{user-name}{#{{colors.outline.default.hex}}}@{#{{colors.secondary.default.hex}}}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "{#{{colors.outline_variant.default.hex}}}{$1}{#}"
        },
        "break",
        {
            "type": "os",
            "key": "{icon}  OS",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "kernel",
            "key": "󰌽  Kernel",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "wm",
            "key": "󰧨  WM",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "shell",
            "key": "󰆍  Shell",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "custom",
            "key": "  User",
            "keyColor": "{{colors.primary.default.hex}}",
            "format": "{#{{colors.on_surface.default.hex}}}{$USER}{#}"
        },
        "break",
        {
            "type": "cpu",
            "key": "󰻠  CPU",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "gpu",
            "key": "󰍛  GPU",
            "keyColor": "{{colors.tertiary.default.hex}}"
        }
    ]
}
